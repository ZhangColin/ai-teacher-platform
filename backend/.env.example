# 数据库配置
# MySQL 连接字符串格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 示例: mysql+pymysql://root:password@localhost:3306/ai_teacher_platform?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_teacher_platform?charset=utf8mb4

# JWT 密钥（用于生成和验证 Token）
# 生产环境必须修改为强随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production

# ===== AI 模型配置 =====
# 当前使用的服务商：openai / deepseek / kimi
# 默认使用 deepseek（国内稳定，性价比高）
CURRENT_PROVIDER=deepseek

# AI 请求超时时间（秒），默认 120 秒
AI_REQUEST_TIMEOUT=120

# ----- OpenAI 配置 -----
# 官方 API: https://platform.openai.com/
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ----- DeepSeek 配置 -----
# 官方网站: https://platform.deepseek.com/
# DeepSeek V3: 性能强劲，成本极低
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- Kimi (Moonshot) 配置 -----
# 官方网站: https://platform.moonshot.cn/
# 长上下文优势：moonshot-v1-8k / moonshot-v1-32k / moonshot-v1-128k
KIMI_API_KEY=sk-your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ----- 特殊场景配置 -----
# 标题生成专用模型（可选，格式：provider:model_name）
# 如果不配置，优先使用 DeepSeek（成本最低），然后使用 CURRENT_PROVIDER
# TITLE_GENERATION_MODEL=deepseek:deepseek-chat

# ----- GLM (智谱AI) 配置 -----
# 官方网站: https://open.bigmodel.cn/
# 用于多模态生成（图片、音频、视频）
# 图片生成模型: cogview-3, cogview-3-plus
GLM_API_KEY=sk-your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4
