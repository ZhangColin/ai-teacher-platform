# 数据库配置
# MySQL 连接字符串格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 示例: mysql+pymysql://root:password@localhost:3306/ai_teacher_platform?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_teacher_platform?charset=utf8mb4

# JWT 密钥（用于生成和验证 Token）
# 生产环境必须修改为强随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production

# OpenAI API 配置（如果使用）
# OPENAI_API_KEY=your-api-key-here
