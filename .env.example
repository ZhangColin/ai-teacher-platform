# ============================================
# AI 教育平台 - 环境变量配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 编辑 .env 文件，填入实际配置
# 3. 注意：.env 文件不要提交到 Git

# ============================================
# 数据库配置
# ============================================
# 情况1: MySQL 在同一 Podman 网络，使用容器名称
# DATABASE_URL=mysql+pymysql://root:password@mysql:3306/studio?charset=utf8mb4

# 情况2: MySQL 在不同网络，使用容器 IP
# 先获取 IP: podman inspect <mysql-container-name> | grep IPAddress
# DATABASE_URL=mysql+pymysql://root:password@172.17.0.2:3306/studio?charset=utf8mb4

# 情况3: MySQL 使用主机网络，使用 localhost
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/studio?charset=utf8mb4

# 示例（请根据实际情况修改）:
DATABASE_URL=mysql+pymysql://root:your_password@mysql:3306/studio?charset=utf8mb4

# ============================================
# JWT 密钥（生产环境必须修改）
# ============================================
# 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-strong-random-secret-key-here-change-this-in-production

# ============================================
# AI 服务配置
# ============================================
# 当前使用的 AI 服务提供商（kimi 或 deepseek）
CURRENT_PROVIDER=kimi

# Kimi API 配置
KIMI_API_KEY=sk-your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# DeepSeek API 配置（可选）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AI 请求超时时间（秒），默认 120 秒
AI_REQUEST_TIMEOUT=120

# ============================================
# 静态文件目录（通常不需要修改）
# ============================================
STATIC_DIR=/app/static
